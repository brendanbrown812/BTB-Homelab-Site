POSTGRES_DB=btb
POSTGRES_USER=btb
POSTGRES_PASSWORD=replace-with-a-long-password
DATABASE_URL=sqlite+aiosqlite:///./btb-local.db
LOCAL_CREATE_SCHEMA=true
SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=43200
SLEEPER_BASE_URL=https://api.sleeper.app/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_SITE_URL=http://localhost:3000
DISCORD_POLL_WEBHOOK_URL=
DISCORD_POLL_ROLE_ID=
# Active league used by the live predictions feature. Historical Sleeper IDs are entered per season in Admin.
SLEEPER_LEAGUE_ID=put-your-current-sleeper-league-id-here
SEASON_YEAR=2026
# Temporary, read-only settings used only for the one-time 2020–2021 import. Leave blank afterward.
# Use either the data-source ID or database container ID; never commit a real token.
NOTION_API_TOKEN=
NOTION_GAME_HISTORY_DATA_SOURCE_ID=
NOTION_GAME_HISTORY_DATABASE_ID=
NOTION_API_VERSION=2026-03-11
NOTION_TIMEOUT_SECONDS=20
# Background scheduler tuning. Defaults are suitable for the Docker deployment.
TASK_POLL_SECONDS=30
TASK_LEASE_SECONDS=900
TASK_RETRY_MINUTES=15
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Bootstrap Admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-admin-password
